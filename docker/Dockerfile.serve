# syntax=docker/dockerfile:1

FROM python:3.11-slim
WORKDIR /app

# curl is needed by the HEALTHCHECK below; clean apt caches to stay lean.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install ONLY serving dependencies (no training-only libraries).
COPY requirements/serve.txt .
RUN pip install --no-cache-dir --timeout 120 --retries 10 \
        torch==2.13.0 torchvision==0.28.0 \
        --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir --timeout 120 --retries 10 \
        fastapi==0.139.0 uvicorn==0.49.0 pillow==11.3.0 python-multipart==0.0.32

# Copy the serving source code.
COPY src/ ./src/

# Create and switch to a non-root user for security.
RUN useradd --create-home --uid 1000 appuser
USER appuser

# Document the port the app listens on.
EXPOSE 8080

ENV PYTHONUNBUFFERED=1

# Periodically verify the app is healthy by hitting /health.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start the FastAPI server.
CMD ["uvicorn", "serve:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8080"]
